{
  "name": "@onekeyfe/hd-transport",
  "version": "1.2.11-alpha.10",
  "description": "Transport layer abstractions and utilities for OneKey hardware SDK.",
  "author": "OneKey",
  "homepage": "https://github.com/OneKeyHQ/hardware-js-sdk#readme",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "rimraf dist && rollup -c ./rollup.config.js -w",
    "build": "rimraf dist && rollup -c ./rollup.config.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update:protobuf": "./scripts/protobuf-build.sh",
    "test:static-csp": "node --disallow-code-generation-from-strings scripts/protobuf-static-csp.js",
    "check:source": "node scripts/protobuf-source-check.js"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@types/bytebuffer": "^5.0.42",
    "@types/w3c-web-usb": "^1.0.10",
    "@types/web-bluetooth": "^0.0.21",
    "long": "^4.0.0",
    "protobufjs": "6.11.6"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "bytebuffer": "^5.0.1"
  }
}
