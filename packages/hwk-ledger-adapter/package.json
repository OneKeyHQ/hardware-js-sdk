{
  "name": "@onekeyfe/hwk-ledger-adapter",
  "version": "1.2.3-alpha.1",
  "description": "Ledger hardware wallet adapter for OneKey",
  "author": "OneKey",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/hardware-js-sdk.git",
    "directory": "packages/hwk-ledger-adapter"
  },
  "keywords": [
    "ledger",
    "hardware-wallet",
    "onekey",
    "crypto"
  ],
  "dependencies": {
    "@ledgerhq/context-module": "2.2.0",
    "@ledgerhq/device-management-kit": "1.9.0",
    "@ledgerhq/device-signer-kit-bitcoin": "1.3.3",
    "@ledgerhq/device-signer-kit-ethereum": "1.16.0",
    "@ledgerhq/device-signer-kit-solana": "1.10.0",
    "@ledgerhq/device-signer-kit-zcash": "0.7.1",
    "@ledgerhq/hw-app-trx": "^6.34.1",
    "@ledgerhq/hw-transport": "^6.34.1",
    "@onekeyfe/hwk-adapter-core": "1.2.3-alpha.1",
    "bitcoinjs-lib": "npm:@onekeyfe/bitcoinjs-lib@7.0.1",
    "bs58": "6.0.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
