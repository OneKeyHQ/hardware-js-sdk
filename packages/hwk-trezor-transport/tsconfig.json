{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": ".",
    "useUnknownInCatchVariables": false,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@trezor/protocol": ["../hwk-trezor-protocol/src/index.ts"],
      "@trezor/protocol/*": ["../hwk-trezor-protocol/src/*"],
      "@trezor/transport-common": ["../hwk-trezor-transport-common/src/index.ts"],
      "@trezor/transport-common/*": ["../hwk-trezor-transport-common/src/*"],
      "@trezor/type-utils": ["../hwk-trezor-type-utils/src/index.ts"],
      "@trezor/type-utils/*": ["../hwk-trezor-type-utils/src/*"],
      "@trezor/utils": ["../hwk-trezor-utils/src/index.ts"],
      "@trezor/utils/*": ["../hwk-trezor-utils/src/*"]
    }
  },
  "include": ["src/**/*", "hwk.ts"]
}
