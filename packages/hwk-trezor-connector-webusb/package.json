{
  "name": "@onekeyfe/hwk-trezor-connector-webusb",
  "version": "1.2.2-alpha.14",
  "description": "IConnector implementation for Trezor hardware wallets via WebUSB",
  "author": "OneKey",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.mts",
        "default": "./dist/constants.mjs"
      },
      "require": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/hardware-js-sdk.git",
    "directory": "packages/hwk-trezor-connector-webusb"
  },
  "keywords": [
    "trezor",
    "webusb",
    "usb",
    "hardware-wallet",
    "onekey",
    "connector"
  ],
  "dependencies": {
    "@onekeyfe/hwk-adapter-core": "1.2.2-alpha.14",
    "@onekeyfe/hwk-trezor-connector": "1.2.2-alpha.14",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.1.6"
  }
}
