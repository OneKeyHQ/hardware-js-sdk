{
  "name": "@onekeyfe/hwk-trezor-adapter",
  "version": "1.2.2-alpha.104",
  "description": "Trezor hardware wallet adapter primitives for OneKey",
  "author": "OneKey",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/hardware-js-sdk.git",
    "directory": "packages/hwk-trezor-adapter"
  },
  "keywords": [
    "trezor",
    "hardware-wallet",
    "onekey",
    "crypto"
  ],
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.3.3",
    "@onekeyfe/hwk-adapter-core": "1.2.2-alpha.104",
    "@onekeyfe/hwk-trezor-core": "1.2.2-alpha.104",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.1.6"
  }
}
