{
  "name": "@onekeyfe/cli-example",
  "version": "1.1.26",
  "private": true,
  "description": "CLI example for testing NodeUsbTransport communication",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "search": "ts-node src/index.ts search",
    "get-features": "ts-node src/index.ts get-features",
    "get-address": "ts-node src/index.ts get-address",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "dependencies": {
    "@onekeyfe/hd-common-connect-sdk": "1.1.26",
    "@onekeyfe/hd-transport-usb": "1.1.26",
    "@onekeyfe/hd-core": "1.1.26",
    "@onekeyfe/hd-shared": "1.1.26"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0"
  }
}
