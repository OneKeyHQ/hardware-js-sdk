{
  "name": "@onekeyfe/hwk-keystone-adapter",
  "version": "1.2.2-alpha.100",
  "description": "Keystone hardware wallet adapter (QR + USB) for OneKey",
  "author": "OneKey",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/hardware-js-sdk.git",
    "directory": "packages/hwk-keystone-adapter"
  },
  "keywords": [
    "keystone",
    "hardware-wallet",
    "air-gap",
    "onekey",
    "crypto"
  ],
  "dependencies": {
    "@keystonehq/bc-ur-registry": "0.8.0",
    "@keystonehq/bc-ur-registry-eth": "0.22.1",
    "@keystonehq/keystone-sdk": "0.12.3",
    "@onekeyfe/hwk-adapter-core": "1.2.2-alpha.100",
    "bitcoinjs-lib": "npm:@onekeyfe/bitcoinjs-lib@7.0.1",
    "bs58": "5.0.0",
    "bs58check": "3.0.1",
    "hdkey": "2.1.0",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@keystonehq/bc-ur-registry-sol": "0.9.3",
    "@types/bs58check": "^2.1.2",
    "@types/hdkey": "^2.0.1",
    "@types/uuid": "^8.3.4",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
