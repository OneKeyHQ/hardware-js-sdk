{
  "name": "@onekeyfe/hwk-trezor-protobuf",
  "version": "1.2.2-alpha.11",
  "private": true,
  "description": "Trezor protobuf helpers vendored from Trezor Suite MIT sources",
  "author": "OneKey",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./hwk": {
      "import": {
        "types": "./dist/hwk.d.mts",
        "default": "./dist/hwk.mjs"
      },
      "require": {
        "types": "./dist/hwk.d.ts",
        "default": "./dist/hwk.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md",
    "TREZOR_SOURCE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/hardware-js-sdk.git",
    "directory": "packages/hwk-trezor-protobuf"
  },
  "sideEffects": false,
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@onekeyfe/hwk-trezor-schema-utils": "1.2.2-alpha.11"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.1.6"
  }
}
